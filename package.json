{
  "name": "exploding-kittens",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "server": "npm run build:server && node dist/server/server/server.js",
    "server:dev": "nodemon --watch src/server --watch src/common --ext ts --exec \"npm run server\"",
    "build:server": "tsc -p src/server/tsconfig.json",
    "test": "npm run build:server && vitest run",
    "start": "node dist/server/server/server.js"
  },
  "dependencies": {
    "boardgame.io": "^0.50.2",
    "koa-static": "^5.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/koa-static": "^4.0.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "socket.io": "^4.8.3",
    "socket.io-parser": "^4.2.7",
    "ws": "^8.22.0",
    "qs": "^6.16.1",
    "cookie": "^0.7.2",
    "@koa/cors": "^5.0.0",
    "nanoid": "^3.3.20"
  },
  "engines": {
    "node": ">=24"
  }
}
